{
  "name": "@hornet-swarm/report",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/ia-findings.schema.json dist/ia-findings.schema.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hornet-swarm/core": "workspace:*",
    "jszip": "3.10.1",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jszip": "3.4.1",
    "@types/pngjs": "6.0.5"
  }
}
